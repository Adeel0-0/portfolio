---
import "../styles/site.css";
import "../styles/modes.css";
import "../styles/transition.css";
import "../styles/boot.css";
import { person } from "../data/site";
import { BOOT } from "../lib/boot-sequence";
import { THEME_COLORS } from "../lib/theme-state";
import { resumeHref } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Mohammad Adeel — AI & software engineer",
  description = person.introduction,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const links = [
  { href: "/projects/", text: "Projects" },
  { href: "/about/", text: "About" },
  { href: "/certifications/", text: "Credentials" },
];
---

<!doctype html>
<html lang="en" data-theme="professional">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLORS.professional} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline define:vars={{ themeColors: THEME_COLORS }}>
      // Mode precedence: an explicit ?mode=f1|minimal URL choice, then the
      // remembered choice, then Minimal. A URL choice is also remembered.
      let mode = null;
      try {
        const param = new URLSearchParams(location.search).get("mode");
        if (param === "f1" || param === "minimal") {
          mode = param === "f1" ? "f1" : "professional";
          try {
            localStorage.setItem("portfolio-theme", mode);
          } catch {
            /* Storage is optional; the URL still applies to this page. */
          }
        }
      } catch {
        /* Unusual URL APIs: fall back to the remembered choice. */
      }
      try {
        if (mode === null) mode = localStorage.getItem("portfolio-theme");
      } catch {
        /* Storage is optional. */
      }
      try {
        if (mode === "f1") {
          document.documentElement.dataset.theme = "f1";
          // F1 text uses Saira from the first paint.
          const font = document.createElement("link");
          font.rel = "preload";
          font.as = "font";
          font.type = "font/woff2";
          font.href = "/fonts/saira-var.woff2";
          font.crossOrigin = "anonymous";
          document.head.append(font);
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", themeColors.f1);
        }
      } catch {
        /* Storage is optional. */
      }
    </script>
    <script
      is:inline
      define:vars={{
        bootKey: BOOT.sessionKey,
        replay: import.meta.env.DEV,
        ceiling: BOOT.failsafe + 650,
        cancelEvent: BOOT.cancelEvent,
      }}
    >
      // Boot terminal gate: decide before first paint so the page never flashes
      // in first. boot-terminal.ts builds the sequence; the ceiling hands the
      // page back even if that script never arrives. Dev replays every load.
      const root = document.documentElement;
      let seen = false;
      try {
        seen = !replay && sessionStorage.getItem(bootKey) === "1";
      } catch {
        /* Unreadable storage means not seen: it plays. */
      }
      if (!seen && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        root.dataset.preloader = "running";
        setTimeout(() => {
          if (!root.dataset.preloader) return;
          // Cancel an already-running controller before the fallback releases
          // the page. Its delayed callbacks must never hide the page again.
          document.dispatchEvent(new Event(cancelEvent));
          document
            .querySelectorAll(".boot-terminal")
            .forEach((n) => n.remove());
          delete root.dataset.preloader;
          root.style.removeProperty("--pl-launch");
        }, ceiling);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <!-- Fixed chrome stays outside: the boot hand-off transforms this shell. -->
    <div id="site-shell">
      <header class="site-header">
        <div class="header-inner">
          <a class="wordmark" href="/" aria-label="Mohammad Adeel, home">
            adeel<span aria-hidden="true">.</span>
          </a>
          <nav class="desktop-nav" aria-label="Main navigation">
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={path.startsWith(link.href) ? "page" : undefined}
              >
                {link.text}
              </a>
            ))}
            <a href="/#contact">Contact</a>
            {resumeHref && <a href={resumeHref}>Resume</a>}
          </nav>
          <div class="header-actions">
            <button
              class="theme-toggle"
              id="theme-toggle"
              type="button"
              aria-pressed="false"
              hidden
            >
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 17 9 7h5l-6 10H3Zm9 0 6-10h3l-6 10h-3Z"
                  fill="currentColor"
                />
              </svg>
              <span>F1 mode</span>
              <span class="toggle-state" aria-hidden="true"></span>
            </button>
            <details class="mobile-menu">
              <summary>
                Menu <span aria-hidden="true">+</span>
              </summary>
              <nav aria-label="Mobile navigation">
                {links.map((link) => (
                  <a href={link.href}>{link.text}</a>
                ))}
                <a href="/#contact">Contact</a>
                {resumeHref && <a href={resumeHref}>Resume</a>}
              </nav>
            </details>
          </div>
        </div>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer id="contact" class="site-footer">
        <div class="container contact-grid">
          <div>
            <p class="eyebrow">Let’s build something useful</p>
            <h2>
              Good work starts
              <br />
              with a conversation.
            </h2>
          </div>
          <div class="contact-actions">
            <a class="contact-email" href={`mailto:${person.email}`}>
              Send me an email <span aria-hidden="true">↗</span>
            </a>
            <p>
              Based in {person.location}.{" "}
              <button type="button" class="copy-email" data-email={person.email} hidden>
                Copy email address
              </button>
              <span class="copy-status" role="status"></span>
            </p>
            <div class="footer-links">
              <a href={person.github} target="_blank" rel="noreferrer">
                GitHub
              </a>
              <a href={person.linkedin} target="_blank" rel="noreferrer">
                LinkedIn
              </a>
              {resumeHref && <a href={resumeHref}>Resume PDF</a>}
            </div>
          </div>
        </div>
        <div class="container footer-base">
          <a class="wordmark" href="/">
            adeel<span>.</span>
          </a>
          <p>Thoughtful software. A little racing spirit.</p>
          <a href="#main">Back to top ↑</a>
        </div>
      </footer>
    </div>
    <!-- Fixed chrome stays outside #site-shell (the boot hand-off transforms it). -->
    <div id="f1-backdrop" class="f1-backdrop" aria-hidden="true" data-state="static"></div>
    <div
      id="theme-announcement"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
    ></div>
    <script>
      import "../scripts/boot-terminal";
    </script>
    <script>
      import "../scripts/theme";
      import "../scripts/copy-email";
      import "../scripts/f1-backdrop";
      import "../scripts/racing-loader";
    </script>
  </body>
</html>
