---
import SiteLayout from "../layouts/SiteLayout.astro";
import F1PitWall from "../components/F1PitWall.astro";
import F1Paddock from "../components/F1Paddock.astro";
import PipelineFigure from "../components/PipelineFigure.astro";
import PaperTable from "../components/PaperTable.astro";
import { getPublishedPortfolio, resumeHref } from "../lib/content";
import { person, capabilities, paper } from "../data/site";
import { education } from "../data/education";
const portfolio = await getPublishedPortfolio();
const projects = portfolio.projects
  .filter((p) => p.data.featuredOrder !== undefined)
  .slice(0, 3);
const credentials = portfolio.credentials;

// Preprint: the figure follows the configured project if it is published.
const figureProject =
  portfolio.projects.find((p) => p.id === paper.figure.project) ??
  portfolio.projects[0];
// The highlighted term is part of the abstract; split around it.
const [before, after] = paper.abstract.includes(paper.highlight)
  ? paper.abstract.split(paper.highlight)
  : [paper.abstract, undefined];
// Repository links become footnotes on the table, numbered in table order.
const footnoted = portfolio.projects.filter((p) => p.data.repositoryUrl);
const footnotes = Object.fromEntries(footnoted.map((p, i) => [p.id, i + 1]));
const credentialKinds = {
  certification: "Certification",
  "course-completion": "Course completion",
  badge: "Badge",
};
---

<SiteLayout>
  <F1PitWall projects={projects} resumeHref={resumeHref} />

  <!-- Preprint: the title page. -->
  <header
    class="pp-title mode-minimal"
    id="sec-intro"
    data-section="intro"
    aria-labelledby="pp-title"
  >
    <h1 id="pp-title">
      {paper.title}: {paper.subtitle}
    </h1>
    <p class="pp-author">{person.displayName}<sup>1</sup></p>
    <p class="pp-aff"><sup>1</sup> {paper.affiliation}</p>
    <div class="pp-actions">
      <a class="pp-btn primary" href="#sec-work">Explore my work →</a>
      {resumeHref && (
        <a class="pp-btn" href={resumeHref}>
          View resume
        </a>
      )}
    </div>
    <p class="pp-abstract">
      <span class="pp-lab">Abstract —</span>
      {before}{after !== undefined && (
        <>
          <mark class="pp-hl">{paper.highlight}</mark>{after}
        </>
      )}
    </p>
  </header>

  <!-- Preprint §1: selected work. -->
  <section
    class="pp-sec mode-minimal"
    id="sec-work"
    data-section="work"
    aria-labelledby="pp-h-work"
  >
    <h2 class="pp-h2" id="pp-h-work"><span class="pp-n">1</span> Selected work</h2>
    <div class="pp-body">
      <div class="pp-noted">
        <p>
          {paper.workLead}{" "}
          <a class="pp-xref" href="#fig-1">Fig. 1</a> shows the pipeline of the
          featured project, {figureProject.data.title}, and{" "}
          <a class="pp-xref" href="#tab-1">Table 1</a> lists all of them with
          their status. Each row opens the project as its own paper.
        </p>
        <aside class="pp-note">{paper.marginNote}</aside>
      </div>
    </div>
    <PipelineFigure
      id="fig-1"
      number={1}
      stages={figureProject.data.diagram}
      focus={paper.figure.focus}
      focusHref={`/projects/${figureProject.id}/`}
      annotations={paper.figure.annotations}
      caption={paper.figure.caption}
    />
    <PaperTable
      id="tab-1"
      number={1}
      caption="All projects. Each row links to its case study."
      projects={portfolio.projects}
      footnotes={footnotes}
    />
  </section>

  <!-- Preprint §2: capabilities, short enough for two columns. -->
  <section
    class="pp-sec mode-minimal"
    id="sec-skills"
    data-section="skills"
    aria-labelledby="pp-h-skills"
  >
    <h2 class="pp-h2" id="pp-h-skills"><span class="pp-n">2</span> Capabilities</h2>
    <div class="pp-body pp-cols">
      {capabilities.map((capability, i) => (
        <p>
          <i>{capability.title}.</i> {capability.description}{" "}
          {capability.skills.map((skill, j) => (
            <>
              <a href={`/projects/?skill=${encodeURIComponent(skill)}`}>{skill}</a>
              {j < capability.skills.length - 1 ? ", " : "."}
            </>
          ))}
          {i === capabilities.length - 1 && (
            <>
              {" "}The projects behind these are in{" "}
              <a class="pp-xref" href="#sec-work">§1</a>.
            </>
          )}
        </p>
      ))}
    </div>
  </section>

  <!-- Preprint §3: about the author. -->
  <section
    class="pp-sec mode-minimal"
    id="sec-about"
    data-section="about"
    aria-labelledby="pp-h-about"
  >
    <h2 class="pp-h2" id="pp-h-about"><span class="pp-n">3</span> About the author</h2>
    <div class="pp-bio">
      <img
        src={person.avatar.src}
        alt={`Portrait of ${person.displayName}`}
        width="58"
        height="70"
        loading="lazy"
        decoding="async"
      />
      <p>
        <b>{person.displayName}</b> {paper.bio} {education.degree},{" "}
        {education.school}, {education.period}.{" "}
        <a href="/about/">More about me →</a>
      </p>
    </div>
  </section>

  {credentials.length > 0 && (
    <section class="pp-sec mode-minimal" aria-labelledby="pp-h-cred">
      <h2 class="pp-h2" id="pp-h-cred">Appendix A — Credentials</h2>
      <div class="pp-table">
        <table>
          <thead>
            <tr>
              <th scope="col">Credential</th>
              <th scope="col">Issuer</th>
              <th scope="col">Kind</th>
            </tr>
          </thead>
          <tbody>
            {credentials.map(({ data: c }) => (
              <tr>
                <td>
                  {c.verificationUrl ? <a href={c.verificationUrl}>{c.title}</a> : c.title}
                </td>
                <td>{c.issuer}</td>
                <td>{credentialKinds[c.kind]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {footnoted.length > 0 && (
    <ol class="pp-fn mode-minimal" aria-label="Footnotes">
      {footnoted.map((project, i) => (
        <li id={`fn-${i + 1}`}>
          {project.data.title} repository:{" "}
          <a href={project.data.repositoryUrl}>
            {project.data.repositoryUrl!.replace(/^https?:\/\//, "")}
          </a>
          .{" "}
          <a href={`#fnref-${i + 1}`} aria-label="Back to the table">
            ↩
          </a>
        </li>
      ))}
    </ol>
  )}

  <!-- F1 composition: unchanged from the previous site. -->
  <section
    id="capabilities"
    class="capabilities-section mode-f1"
    data-section="skills"
    aria-labelledby="capabilities-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 id="capabilities-title">
            From a question
            <br />
            to a working system.
          </h2>
        </div>
        <p class="section-description">
          Engineering is the connective tissue between a promising idea and
          something useful.
        </p>
      </div>
      <div class="capabilities-grid">
        {capabilities.map((capability, i) => (
          <article>
            <svg
              class="capability-icon"
              viewBox="0 0 32 32"
              fill="none"
              aria-hidden="true"
            >
              <rect
                x="4"
                y="4"
                width="24"
                height="24"
                rx={i === 0 ? 12 : 5}
                stroke="currentColor"
                stroke-width="1.5"
              />
              <path
                d={
                  i === 0
                    ? "M4 16h24M16 4v24M8 8l16 16M8 24 24 8"
                    : i === 1
                      ? "m11 10-5 6 5 6m10-12 5 6-5 6M18 9l-4 14"
                      : "m9 16 5 5 9-11"
                }
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
            <div class="capability-links">
              {capability.skills.slice(0, 3).map((skill) => (
                <a href={`/projects/?skill=${encodeURIComponent(skill)}`}>
                  {skill}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <F1Paddock />
  <section id="about" class="section container about-strip mode-f1" data-section="about">
    <div>
      <p class="eyebrow">A little about me</p>
      <h2>
        Always learning.
        <br />
        Always building.
      </h2>
    </div>
    <div>
      <p class="large-copy">{person.bio}</p>
      <a class="text-link" href="/about/">
        More about me <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  {credentials.length > 0 && (
    <section class="section container mode-f1">
      <h2>Learning, put into practice.</h2>
      <p>
        {credentials.length} published credential
        {credentials.length === 1 ? "" : "s"}, connected to my work.
      </p>
      <a class="text-link" href="/certifications/">
        Explore credentials
      </a>
    </section>
  )}
</SiteLayout>
