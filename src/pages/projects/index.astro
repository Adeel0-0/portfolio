---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getPublishedProjects } from "../../lib/content";
import { capabilities } from "../../data/site";
const projects = await getPublishedProjects();
const skills = [...new Set(projects.flatMap((p) => p.data.skills))].sort();
// Skills the home page may link here, including ones no published project uses.
const linkedSkills = [...new Set(capabilities.flatMap((c) => c.skills))];
---

<SiteLayout title="Projects — Mohammad Adeel">
  <section class="container page-intro">
    <p class="eyebrow">Projects</p>
    <h1>Work with a purpose.</h1>
    <p class="large-copy">
      A closer look at the problems, the engineering, and the decisions behind
      each project.
    </p>
  </section>
  <section class="container projects-index section">
    <h2 class="sr-only">Project collection</h2>
    <form class="filter-bar" id="project-filter" hidden>
      <label for="skill-filter">Explore a skill</label>
      <select
        id="skill-filter"
        name="skill"
        data-linked-skills={JSON.stringify(linkedSkills)}
      >
        <option value="">All skills</option>
        {skills.map((skill) => (
          <option value={skill}>{skill}</option>
        ))}
      </select>
      <p id="filter-status" aria-live="polite">
        {projects.length} projects
      </p>
    </form>
    <div class="project-grid">
      {/* The lead project spans the row, so an odd count never leaves an orphan. */}
      {projects.map((project, i) => (
        <ProjectCard project={project} featured={i === 0 && projects.length % 2 === 1} />
      ))}
    </div>
    <p id="filter-empty" hidden>
      No projects match this skill. Choose “All skills” to see the collection.
    </p>
  </section>
  <script>
    import "../../scripts/filters";
  </script>
</SiteLayout>
