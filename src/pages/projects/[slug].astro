---
import { render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import ProjectMetrics from "../../components/ProjectMetrics.astro";
import { getPublishedProjects } from "../../lib/content";
export async function getStaticPaths() {
  return (await getPublishedProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
---

<SiteLayout title={`${p.title} — Mohammad Adeel`} description={p.summary}>
  <article class="container case-study">
    <a class="back-link" href="/projects/">
      ← All projects
    </a>
    <header class="case-header">
      <p class="eyebrow">{p.category}</p>
      <h1>{p.title}</h1>
      <p class="large-copy">{p.summary}</p>
      <div class="case-facts">
        <div>
          <span>Contribution</span>
          <strong>{p.role}</strong>
        </div>
        <div>
          <span>Project status</span>
          <strong>{p.status.replace("-", " ")}</strong>
        </div>
        <div>
          <span>Page updated</span>
          <time datetime={p.updatedAt}>
            {new Date(p.updatedAt).toLocaleDateString("en-IN", {
              month: "short",
              year: "numeric",
              timeZone: "UTC",
            })}
          </time>
        </div>
      </div>
      <div class="hero-actions">
        {p.videoUrl && (
          <a
            class="button secondary"
            href={p.videoUrl}
            target="_blank"
            rel="noreferrer"
          >
            Watch project demo ↗
          </a>
        )}
        {p.repositoryUrl && (
          <a
            class="button primary"
            href={p.repositoryUrl}
            target="_blank"
            rel="noreferrer"
          >
            Explore the code ↗
          </a>
        )}
        {p.liveUrl && (
          <a
            class="button secondary"
            href={p.liveUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open live project ↗
          </a>
        )}
      </div>
    </header>
    <ProjectMedia project={p} />
    <div class="case-body">
      <aside>
        <h2>Built with</h2>
        <ul class="case-skills">
          {p.skills.map((skill) => (
            <li>
              <a href={`/projects/?skill=${encodeURIComponent(skill)}`}>
                {skill}
              </a>
            </li>
          ))}
        </ul>
      </aside>
      <div class="prose">
        <h2>Project overview</h2>
        {p.description.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <Content />
      </div>
    </div>
  </article>
  <ProjectMetrics metrics={p.metrics} />
</SiteLayout>
