---
import { render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import { getPublishedProjects } from "../../lib/content";
export async function getStaticPaths() {
  return (await getPublishedProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
---

<SiteLayout title={`${p.title} — Mohammad Adeel`} description={p.summary}>
  <article class="container case-study">
    <a class="back-link" href="/projects/">
      ← All projects
    </a>
    <header class="case-header">
      <p class="eyebrow">{p.category}</p>
      <h1>{p.title}</h1>
      <p class="large-copy">{p.summary}</p>
      <div class="case-facts">
        <div>
          <span>Contribution</span>
          <strong>{p.role}</strong>
        </div>
        <div>
          <span>Project status</span>
          <strong>{p.status.replace("-", " ")}</strong>
        </div>
        <div>
          <span>Page updated</span>
          <time datetime={p.updatedAt}>
            {new Date(p.updatedAt).toLocaleDateString("en-IN", {
              month: "short",
              year: "numeric",
              timeZone: "UTC",
            })}
          </time>
        </div>
      </div>
      <div class="hero-actions">
        {p.videoUrl && (
          <a
            class="button secondary"
            href={p.videoUrl}
            target="_blank"
            rel="noreferrer"
          >
            Watch project demo ↗
          </a>
        )}
        {p.repositoryUrl && (
          <a
            class="button primary"
            href={p.repositoryUrl}
            target="_blank"
            rel="noreferrer"
          >
            Explore the code ↗
          </a>
        )}
        {p.liveUrl && (
          <a
            class="button secondary"
            href={p.liveUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open live project ↗
          </a>
        )}
      </div>
    </header>
    {p.media ? (
      <figure class="case-visual">
        <img src={p.media.src} alt={p.media.alt} />
        <figcaption class="figure-caption">{p.media.alt}</figcaption>
      </figure>
    ) : (
      <>
        <ProjectVisual visual={p.visual} diagram={p.diagram} title={p.title} />
        <p class="figure-caption">
          Architecture illustration · {p.diagram.join(" → ")}
        </p>
      </>
    )}
    <div class="case-body">
      <aside>
        <h2>Built with</h2>
        <ul class="case-skills">
          {p.skills.map((skill) => (
            <li>
              <a href={`/projects/?skill=${encodeURIComponent(skill)}`}>
                {skill}
              </a>
            </li>
          ))}
        </ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  {p.metrics.length > 0 && (
    <section class="container metrics-panel" aria-label="Measured results">
      {p.metrics.map((metric) => (
        <article>
          <strong>{metric.value}</strong>
          <h2>{metric.label}</h2>
          <p>{metric.method}</p>
          <p>
            Measured{" "}
            <time datetime={metric.measuredAt}>{metric.measuredAt}</time>
          </p>
          <a href={metric.evidence}>View supporting evidence</a>
        </article>
      ))}
    </section>
  )}
</SiteLayout>
