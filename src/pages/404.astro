---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found — Mohammad Adeel">
  <section class="container page-intro error-page">
    <p class="eyebrow">404</p>
    <h1>A different turn.</h1>
    <p class="large-copy">
      This page couldn’t be found. You can return home or explore the projects.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="/">
        Back home
      </a>
      <a class="button secondary" href="/projects/">
        View projects
      </a>
    </div>
  </section>
</SiteLayout>
