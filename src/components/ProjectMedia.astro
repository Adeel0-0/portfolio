---
import type { CollectionEntry } from "astro:content";
import sharp from "sharp";
import { resolve } from "node:path";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">["data"];
  variant?: "card" | "detail";
}
const { project: p, variant = "detail" } = Astro.props;
// Content validation has already checked this local asset. Read dimensions at
// build time so the browser reserves the right space before downloading it.
const dimensions = p.media
  ? (await sharp(resolve("public", p.media.src.slice(1))).metadata()).autoOrient
  : undefined;
---

{variant === "card" ? (
  p.media ? (
    <img
      class="project-photo"
      src={p.media.src}
      alt=""
      width={dimensions?.width}
      height={dimensions?.height}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <ProjectVisual visual={p.visual} diagram={p.diagram} title={p.title} />
  )
) : (
  <figure class="project-media">
    <div class="media-frame">
      {p.media ? (
        <img
          src={p.media.src}
          alt={p.media.alt}
          width={dimensions?.width}
          height={dimensions?.height}
          decoding="async"
        />
      ) : (
        <ProjectVisual visual={p.visual} diagram={p.diagram} title={p.title} />
      )}
    </div>
    <figcaption class="figure-caption">
      {p.media
        ? p.media.alt
        : `Architecture illustration · ${p.diagram.join(" → ")}`}
    </figcaption>
  </figure>
)}

<style>
  .project-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }
  .project-media {
    margin: 0;
    min-width: 0;
  }
  .media-frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .media-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .media-frame :global(.project-visual) {
    height: 380px;
  }
  @media (max-width: 760px) {
    .media-frame :global(.project-visual) {
      height: 300px;
    }
  }
</style>
