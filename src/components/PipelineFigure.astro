---
// A project pipeline drawn as a paper figure. Two static drawings are emitted:
// a horizontal one, and a vertical one that replaces it in narrow containers,
// so labels never shrink below 13px. Built entirely at build time.
interface Annotation {
  stage: number;
  text: string;
  at: "above" | "below";
}
interface Props {
  id: string;
  number: number;
  stages: readonly string[];
  focus?: number;
  focusHref?: string;
  annotations?: readonly Annotation[];
  caption: string;
}
const {
  id,
  number,
  stages,
  focus = -1,
  focusHref,
  annotations = [],
  caption,
} = Astro.props;

const count = stages.length;
const gap = 43;
const width = 852;
const boxW = (width - gap * (count - 1)) / count;
const boxY = 50;
const boxH = 44;
const note = (i: number) => annotations.find((a) => a.stage === i);

const vBoxW = 160;
const vBoxH = 40;
const vGap = 28;
const vHeight = count * vBoxH + (count - 1) * vGap + 16;
const label = stages.join(", ");
---

<figure class:list={["pp-fig mode-minimal", { "pp-fig-tall": count > 5 }]} id={id}>
  <svg
    class="pp-fig-h"
    viewBox={`0 0 ${width} 150`}
    role="group"
    aria-label={`Figure ${number}, left to right: ${label}`}
  >
    <defs>
      <marker
        id={`${id}-ah`}
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="8"
        markerHeight="8"
        orient="auto"
      >
        <path class="pp-ink-fill" d="M0 0L8 4L0 8Z"></path>
      </marker>
    </defs>
    {stages.map((stage, i) => {
      const x = i * (boxW + gap);
      const hot = i === focus;
      const a = note(i);
      const box = (
        <g>
          <rect class:list={["pp-box", { hot }]} x={x} y={boxY} width={boxW} height={boxH}></rect>
          <text class:list={["pp-lbl", { hot }]} x={x + boxW / 2} y={boxY + boxH / 2 + 4.5} text-anchor="middle">{stage}</text>
        </g>
      );
      return (
        <>
          {i > 0 && (
            <path
              class="pp-arrow"
              d={`M${x - gap + 2} ${boxY + boxH / 2}H${x - 3}`}
              marker-end={`url(#${id}-ah)`}
            ></path>
          )}
          {hot && focusHref ? <a href={focusHref}>{box}</a> : box}
          {a && (
            <text
              class="pp-ann"
              x={x + boxW / 2}
              y={a.at === "above" ? boxY - 12 : boxY + boxH + 22}
              text-anchor="middle"
            >
              {a.text}
            </text>
          )}
        </>
      );
    })}
  </svg>
  <svg
    class="pp-fig-v"
    viewBox={`0 0 280 ${vHeight}`}
    role="group"
    aria-label={`Figure ${number}, top to bottom: ${label}`}
  >
    <defs>
      <marker
        id={`${id}-av`}
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="8"
        markerHeight="8"
        orient="auto"
      >
        <path class="pp-ink-fill" d="M0 0L8 4L0 8Z"></path>
      </marker>
    </defs>
    {stages.map((stage, i) => {
      const y = 8 + i * (vBoxH + vGap);
      const hot = i === focus;
      const a = note(i);
      const box = (
        <g>
          <rect class:list={["pp-box", { hot }]} x={8} y={y} width={vBoxW} height={vBoxH}></rect>
          <text class:list={["pp-lbl", { hot }]} x={8 + vBoxW / 2} y={y + vBoxH / 2 + 4.5} text-anchor="middle">{stage}</text>
        </g>
      );
      return (
        <>
          {i > 0 && (
            <path
              class="pp-arrow"
              d={`M${8 + vBoxW / 2} ${y - vGap + 2}V${y - 3}`}
              marker-end={`url(#${id}-av)`}
            ></path>
          )}
          {hot && focusHref ? <a href={focusHref}>{box}</a> : box}
          {a && (
            <text class="pp-ann" x={8 + vBoxW + 10} y={y + vBoxH / 2 + 4.5}>
              {a.text}
            </text>
          )}
        </>
      );
    })}
  </svg>
  <figcaption><b>Figure {number}:</b> {caption}</figcaption>
</figure>
