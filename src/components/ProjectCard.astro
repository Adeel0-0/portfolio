---
import type { CollectionEntry } from "astro:content";
import ProjectMedia from "./ProjectMedia.astro";
interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const p = project.data;
---

<article
  class:list={["project-card", { featured }]}
  data-project
  data-skills={JSON.stringify(p.skills)}
>
  <a
    class="visual-link"
    href={`/projects/${project.id}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    <ProjectMedia project={p} variant="card" />
  </a>
  <div class="project-copy">
    <div class="project-meta">
      <span>{p.category}</span>
      <span class="status">
        {p.status === "in-progress"
          ? "In progress"
          : p.status === "archived"
            ? "Archived"
            : "Completed"}
      </span>
    </div>
    <h3>
      <a href={`/projects/${project.id}/`}>{p.title}</a>
    </h3>
    <p>{p.summary}</p>
    <p class="project-role">{p.role}</p>
    <ul class="skill-list" aria-label="Technologies">
      {p.skills.slice(0, 3).map((skill) => (
        <li>{skill}</li>
      ))}
    </ul>
    <div class="project-actions">
      <a class="text-link" href={`/projects/${project.id}/`}>
        Read case study <span aria-hidden="true">↗</span>
      </a>
      {p.repositoryUrl && (
        <a href={p.repositoryUrl} target="_blank" rel="noreferrer">
          View code
        </a>
      )}
    </div>
  </div>
</article>
