{
  "name": "adeel-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/verify-build.mjs",
    "start": "node scripts/serve-built.mjs",
    "lint": "eslint src tests astro.config.mjs playwright.config.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/verify-content-build.mjs && playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.15",
    "astro": "7.4.0",
    "gsap": "3.15.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.14"
  }
}
