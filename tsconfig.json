{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["astro/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "playwright.config.ts"],
  "exclude": ["dist", "node_modules", ".recovery", ".tools"]
}
