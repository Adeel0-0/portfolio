# Canonical origin for canonical URLs, Open Graph and sitemap links.
#
# Optional. Leave unset on Vercel: astro.config.mjs falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets automatically at build time
# and which points at the stable production domain rather than the per-deploy
# preview URL.
#
# Set it explicitly once a custom domain exists, or to make a local build
# produce production-shaped absolute URLs. No trailing slash needed.
#
# SITE_URL=https://your-domain.com
